{
  "name": "@iamandersonp/nx-ionic-cordova",
  "version": "1.0.0",
  "description": "Nx plugin for Ionic/Cordova workspaces: scaffolds apps, runs native Cordova CLI commands scoped to one app, and maps Ionic CLI hooks to Nx targets.",
  "private": false,
  "keywords": [
    "nx",
    "ionic",
    "cordova"
  ],
  "author": "Anderson Penaloza <info@iamanderson.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamandersonp/nx-tools.git"
  },
  "homepage": "https://github.com/iamandersonp/nx-tools.git",
  "readme": "README.md",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "out-tsc/lib",
    "executors.json",
    "generators.json",
    "src/executors/native/schema.json",
    "src/executors/ionic-hook/schema.json",
    "src/generators/init/schema.json",
    "src/generators/app/schema.json",
    "README.md"
  ],
  "main": "./out-tsc/lib/src/index.js",
  "generators": "./generators.json",
  "executors": "./executors.json",
  "bin": {
    "nx-ionic-hook": "out-tsc/lib/src/cli/ionic-hook.js"
  },
  "peerDependencies": {
    "@nx/devkit": "^23",
    "nx": "^23"
  }
}
